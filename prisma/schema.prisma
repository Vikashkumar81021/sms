// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
  PRINCIPAL
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubjectType {
  THEORY
  PRACTICAL
}

enum SubjectCategory {
  CORE
  OPTIONAL
}

model User {
  id              Int      @id @default(autoincrement())
  userName        String
  email           String   @unique
  password        String
  role            Role[]   @default([STUDENT])
  phone           String?
  status          Status   @default(ACTIVE)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model School {
  id               Int      @id @default(autoincrement())
  schoolName       String
  schoolCode       Int      @unique
  address          String
  city             String
  state            String
  pinCode          String
  contactNumber    String
  email            String   @unique
  affiliationBoard String
  academicSessions AcademicSession[]
  classes          SchoolClass[]
  subjects         Subject[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AcademicSession {
  id          Int      @id @default(autoincrement())
  sessionName String

  schoolId    Int
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, sessionName])
}

model SchoolClass {
  id           Int      @id @default(autoincrement())
  className    String
  classCode    String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  schoolId     Int
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sections     Section[]
  subjectMappings  ClassSubject[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, className])
  @@unique([schoolId, classCode])
  @@index([schoolId])
}

model Section {
  id             Int        @id @default(autoincrement())
  sectionName    String
  classTeacher   String?
  roomNumber     String?
  studentCapacity Int       @default(40)

  classId        Int
  schoolClass    SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([classId, sectionName])
  @@index([classId])
}

model Subject {
  id            Int             @id @default(autoincrement())
  subjectName   String
  subjectCode   String
  subjectType   SubjectType     @default(THEORY)
  subjectCategory SubjectCategory @default(CORE)

  schoolId      Int
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classMappings ClassSubject[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([schoolId, subjectName])
  @@unique([schoolId, subjectCode])
  @@index([schoolId])
}

model ClassSubject {
  id        Int        @id @default(autoincrement())

  classId   Int
  subjectId Int

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}